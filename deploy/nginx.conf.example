# Example Nginx server block for this project only.
# Copy to /etc/nginx/sites-available/spaceapps.tannerplayz.com on the server.
# TLS lines depend on the server's existing setup and are intentionally not included here.
server {
    listen 80;
    server_name spaceapps.tannerplayz.com;

    location / {
        proxy_pass http://127.0.0.1:3050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 32k;
    }
}
